// Merge sort written in Pygo on 20k pseudo-random integers.
fn merge_sort(xs: List[Int]) -> List[Int] {
    if xs.len() <= 1 {
        return xs
    }
    let mid = xs.len() / 2
    let left = merge_sort(xs[0..mid])
    let right = merge_sort(xs[mid..xs.len()])
    var out: List[Int] = []
    var i = 0
    var j = 0
    while i < left.len() and j < right.len() {
        if left[i] <= right[j] {
            out.push(left[i])
            i += 1
        } else {
            out.push(right[j])
            j += 1
        }
    }
    while i < left.len() {
        out.push(left[i])
        i += 1
    }
    while j < right.len() {
        out.push(right[j])
        j += 1
    }
    return out
}

fn main() {
    var seed = 12345
    var xs: List[Int] = []
    for i in 0..20000 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        xs.push(seed % 100000)
    }
    let s = merge_sort(xs)
    print(s[0], s[9999], s[19999])
}
