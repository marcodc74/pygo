/// Request received by a server handler. params holds the route parameters
/// set by dispatch ({id} in "/items/{id}"); cookies holds the request cookies.
struct Request { method: Str, path: Str, query: Map[Str, Str], headers: Map[Str, Str], body: Str, params: Map[Str, Str] = {}, cookies: Map[Str, Str] = {} }
/// Cookie sent with a response. max_age in seconds: 0 = until the browser closes, -1 = delete now.
/// same_site is "Lax", "Strict" or "None" ("None" requires secure).
struct Cookie { name: Str, value: Str, path: Str = "/", max_age: Int = 0, http_only: Bool = true, secure: Bool = true, same_site: Str = "Lax" }
/// Response returned by a handler or by a client call.
struct Response { status: Int, body: Str = "", headers: Map[Str, Str] = {}, cookies: List[Cookie] = [] }
/// A route for dispatch. method: GET (also answers HEAD), POST, PUT, PATCH, DELETE, HEAD or OPTIONS.
/// path: literal segments, {name} (one segment) and a final {name...} (the rest of the path).
/// summary, operation_id and tags document the operation in http.openapi.
/// query maps a query parameter name to its type: "Int", "Float", "Str" or "Bool".
/// body and response are the request and 200-response schemas (a struct or enum type).
struct Route {
    method: Str
    path: Str
    handler: fn(Request) -> Response
    summary: Str = ""
    operation_id: Str = ""
    tags: List[Str] = []
    query: Map[Str, Str] = {}
    body: Type[Any]? = nil
    response: Type[Any]? = nil
}
/// A middleware wraps a handler: apply(next) returns the handler to run instead.
/// Pass a list to dispatch: they run left-to-right (the first is outermost) and may
/// short-circuit by returning without calling next.
struct Middleware { name: Str, apply: fn(fn(Request) -> Response) -> fn(Request) -> Response }
/// TLS options for serve: PEM certificate and private-key file paths. The pair
/// is re-read when its modification time or size changes, so a renewal needs no
/// restart. A broken replacement keeps serving the last good certificate.
struct Tls { cert: Str, key: Str }

fn get(url: Str, headers: Map[Str, Str] = {}, timeout_ms: Int = 30000) -> !Response uses net {}
fn post(url: Str, body: Str, headers: Map[Str, Str] = {}, timeout_ms: Int = 30000) -> !Response uses net {}
fn request(method: Str, url: Str, body: Str = "", headers: Map[Str, Str] = {}, timeout_ms: Int = 30000) -> !Response uses net {}
/// Serve HTTP on addr (e.g. ":8080") until SIGINT/SIGTERM (graceful shutdown). handler runs concurrently.
/// Request bodies over max_body bytes get 413 without calling the handler.
/// With tls, serve HTTPS on the same port, reloading the certificate from disk when it changes.
fn serve(addr: Str, handler: fn(Request) -> Response, max_body: Int = 1048576, tls: Tls? = nil) -> ! uses net {}
/// Calls the handler of the FIRST route whose method and path match, with req.params set.
/// A path that matches only with another method gives 405 (header allow), no match 404.
/// middleware wraps the outcome (including 404/405).
fn dispatch(req: Request, routes: List[Route], middleware: List[Middleware] = []) -> Response {}
/// Middleware that turns a handler panic into a 500 response (one JSON line on stderr).
fn recover() -> Middleware {}
/// Middleware that logs one JSON access line per request to stderr.
fn log_requests() -> Middleware {}
/// Middleware that reads X-Request-Id (or generates one) and echoes it on the response.
fn request_id() -> Middleware {}
/// Middleware that answers 503 if the handler runs longer than ms milliseconds.
fn timeout(ms: Int) -> Middleware {}
/// Middleware that records request counters, latency and in-flight gauge.
fn metrics() -> Middleware {}
/// Prometheus text exposition of the metrics recorded so far (serve it at /metrics).
fn metrics_text() -> Str {}
/// Middleware that exports one OTLP/HTTP span per request to endpoint (a base URL,
/// or a full .../v1/traces URL). Trace and span ids are reproducible under --seed.
fn tracing(service: Str, endpoint: Str) -> Middleware uses net {}
/// OpenAPI 3.1 document (JSON) for routes: one operation per route, with path and
/// query parameters and, when given, JSON Schemas for body and response built from
/// their struct/enum types. Serve it at /openapi.json and render it with any viewer.
fn openapi(routes: List[Route], title: Str, version: Str = "1.0.0", description: Str = "", server: Str = "") -> Str {}
/// Serves the file req.params["path"] (route "/static/{path...}") from dir, with its content type.
/// Hidden files (.env), ".." and symlinks leading outside dir give 404.
fn static(req: Request, dir: Str) -> Response uses fs {}
/// Fields of an application/x-www-form-urlencoded body (HTML form POST).
fn form(req: Request) -> !Map[Str, Str] {}
/// Redirect (303 See Other by default: the usual answer to a form POST).
fn redirect(location: Str, status: Int = 303) -> Response {}
/// Plain-text response.
fn text(status: Int, body: Str) -> Response {}
/// JSON response (body is encoded with json.encode).
fn json(status: Int, body: Any) -> Response {}
/// HTML page or fragment (content-type text/html; charset=utf-8); build body with html"...".
fn html(status: Int, body: Html) -> Response {}
